# Server Configuration
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
PUBLIC_SURVEY_BASE_URL=https://adminview-eight.vercel.app

# Google Gemini API (SERVER-SIDE ONLY - NEVER put in frontend .env files)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Supabase Server Credentials (SERVER-SIDE ONLY for Storage retrieval & DB persistence)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_optional_fallback
SUPABASE_STORAGE_BUCKET=proposal-documents

# Institutional Email Delivery — Option A: SMTP via Nodemailer
# Smart auto-defaults:
#   - @gmail.com SMTP_USER -> auto-defaults to smtp.gmail.com:465 (secure=true)
#   - @outlook.com / @office365.com OR SMTP_SERVICE=outlook -> auto-defaults to smtp.office365.com:587 (secure=false)
#   - Omitting SMTP_FROM -> auto-defaults to "CampusSync Notifications <SMTP_USER>"
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Institutional Email Delivery — Option B: Resend API
RESEND_API_KEY=
RESEND_FROM="CampusSync Notifications <events@yourdomain.edu>"

# Sandbox Behavior:
# By default, if neither SMTP nor RESEND_API_KEY is configured, the backend automatically uses
# Nodemailer's Ethereal test relay and returns a live previewUrl. Set REQUIRE_LIVE_EMAIL=true to disable sandbox fallback.
REQUIRE_LIVE_EMAIL=false
