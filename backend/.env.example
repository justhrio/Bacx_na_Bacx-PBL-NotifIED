# Server Configuration
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
PUBLIC_SURVEY_BASE_URL=https://adminview-eight.vercel.app

# Google Gemini API (SERVER-SIDE ONLY - NEVER put in frontend .env files)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Supabase Server Credentials (SERVER-SIDE ONLY for Storage retrieval & DB persistence)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_optional_fallback
SUPABASE_STORAGE_BUCKET=proposal-documents

# Institutional Email Delivery — Option A: SMTP via Nodemailer (Gmail App Password, Outlook/Office365, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_institutional_sender@gmail.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM="CampusSync Institutional Events <your_institutional_sender@gmail.com>"

# Institutional Email Delivery — Option B: Resend API Fallback (optional if SMTP is not configured)
RESEND_API_KEY=
RESEND_FROM="CampusSync Institutional Events <events@yourdomain.edu>"
